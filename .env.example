# AI 图像生成服务配置
# 支持的 provider：agnes、pollinations、fallback
IMAGE_GENERATION_PROVIDER=agnes
IMAGE_GENERATION_API_KEY=your_agnes_api_key
IMAGE_GENERATION_API_URL=https://apihub.agnes-ai.com/v1/images/generations

# Agnes AI 默认模型与输出配置
AGNES_MODEL=agnes-image-2.1-flash
AGNES_SIZE=1024x768

# Agnes Chat 润色配置
AGNES_CHAT_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_CHAT_MODEL=agnes-2.0-flash

# Redis 配置（BullMQ 队列使用）
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@your-redis.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres"
